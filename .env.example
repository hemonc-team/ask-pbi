# Не коммитить. На проде: /opt/ask-pbi/.env (chmod 600).
# PBI_CLIENT_SECRET, ASKPBI_MCP_TOKEN, ASKPBI_OAUTH_PASSWORD — только сюда, не в git.

PBI_TENANT_ID=
PBI_CLIENT_ID=
PBI_CLIENT_SECRET=
PBI_AUTH_MODE=service_principal
PBI_TOKENS_PATH=/opt/ask-pbi/var/sp-tokens.json

ASKPBI_TRANSPORT=http
ASKPBI_BIND=127.0.0.1
ASKPBI_PORT=8100
ASKPBI_MCP_TOKEN=
ASKPBI_OAUTH_PASSWORD=
ASKPBI_OAUTH_STORE=/opt/ask-pbi/var/oauth-store.json
ASKPBI_PUBLIC_URL=https://pbi.hemonc.ru/mcp
