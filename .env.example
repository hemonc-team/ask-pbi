# Не коммитить. На проде: /opt/ask-pbi/.env (chmod 600).
# PBI_CLIENT_SECRET и ASKPBI_MCP_TOKEN — только сюда, не в git.

PBI_TENANT_ID=
PBI_CLIENT_ID=
PBI_CLIENT_SECRET=
PBI_AUTH_MODE=service_principal
PBI_TOKENS_PATH=/opt/ask-pbi/var/sp-tokens.json

ASKPBI_TRANSPORT=http
ASKPBI_BIND=127.0.0.1
ASKPBI_PORT=8100
ASKPBI_MCP_TOKEN=
ASKPBI_PUBLIC_URL=https://n8n.hemonc.ru/mcp
